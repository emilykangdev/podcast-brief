# Copy to .env.test.local (for `npm run test:integration`) and to .env.local (for
# `npm run test:e2e` — `next dev` always loads `.env.local`, never `.env.test.local`,
# since it forces NODE_ENV=development internally regardless of the parent shell's
# NODE_ENV). Both are gitignored.
#
# Run `supabase start`, then replace the two placeholders below with its printed
# "Publishable"/"Secret" key values (or run `supabase status -o env` to print them
# again) — they're fixed, publicly-known defaults for every local Supabase CLI
# instance, not real secrets, but GitHub's push-protection secret scanner still
# pattern-matches the sb_publishable_/sb_secret_ prefix, so this file intentionally
# doesn't commit the literal values.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<run `supabase status -o env`, paste PUBLISHABLE_KEY>
SUPABASE_SECRET_KEY=<run `supabase status -o env`, paste SECRET_KEY>
# Raw Postgres connection — only used by tests/integration/helpers/pg-lock.js to hold a
# row lock and deterministically force a race window (see credit-rpcs.test.js / worker-claim.test.js).
SUPABASE_DB_URL=<run `supabase status -o env`, paste DB_URL>
APP_ENV=DEVELOPMENT
NEXT_PUBLIC_DOMAIN_NAME=localhost:3000

# Dummy — Arcjet fails open on key/protect errors by design (see middleware.js, README
# "Security (Arcjet)"), so page routes and API routes still work locally without a real key.
ARCJET_KEY=ajkey_test_fixture_only_not_a_real_key

# Dummy Stripe test-mode key — no live Stripe API call is made in the integration tests
# (findCheckoutSession is mocked). Only used to construct the Stripe SDK client and to
# sign/verify webhook payloads locally via stripe.webhooks.generateTestHeaderString.
# The E2E signup/onboarding journey doesn't touch Stripe at all, but config.js reads these
# price env vars at import time regardless.
STRIPE_SECRET_KEY=sk_test_fixture_only_not_a_real_key
STRIPE_WEBHOOK_SECRET=whsec_fixture_only_not_a_real_secret
NEXT_PUBLIC_STRIPE_PRICE_5_CREDITS=price_test_5credits
NEXT_PUBLIC_STRIPE_PRICE_15_CREDITS=price_test_15credits
NEXT_PUBLIC_STRIPE_PRICE_50_CREDITS=price_test_50credits
